# =============================================================================
# CLIENT — compiled into the browser bundle
# =============================================================================
# Anything prefixed VITE_ is inlined into the JavaScript every visitor
# downloads. Treat these as public.
#
# `vite build` REFUSES to run if either is missing or still a placeholder, so a
# production bundle can never silently ship in demo mode.
#
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# The anon key is safe to expose. RLS policies are the security boundary.
# NEVER put the service_role key in a VITE_ variable.

# =============================================================================
# SERVER — /api/booking only, never sent to the browser
# =============================================================================
# On Vercel these go in Settings → Environment Variables (no VITE_ prefix, so
# Vite cannot pick them up even by accident). Locally they are read by
# `vercel dev`; plain `npm run dev` has no serverless runtime, so the booking
# form falls back to demo mode.

# Same value as VITE_SUPABASE_URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard → Project Settings → API → service_role.
# This key bypasses every RLS policy. If it ever reaches the browser, rotate it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Any long random string. Salts the SHA-256 of submitter IPs so the rate-limit
# buckets cannot be reversed into a list of addresses.
# Generate one with:  openssl rand -hex 32
BOOKING_IP_SALT=change-me-to-a-long-random-string

# =============================================================================
# Local development without a backend
# =============================================================================
# Leave the VITE_ values as placeholders and `npm run dev` falls back to demo
# mode: in-memory fixture data plus a throwaway admin login
# (admin@lumen.dev / admin123). Demo mode is DEV-ONLY — it is compiled out of
# every production build.
